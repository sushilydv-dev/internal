# ---- Zoho account region ----
# One of: com | in | eu | com.au | jp | com.cn | ca | sa
# Aapka Zoho account jis region me signup hua hai (India = "in")
ZOHO_DOMAIN=in

# ---- Zoho Self Client credentials (API Console se milenge) ----
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
# generate_refresh_token.py chalaake yeh value paste karo
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# ---- OpenAI ----
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ---- Flask ----
FLASK_SECRET_KEY=change_this_secret_key

# ---- Zoho Recruit ----
# Candidates module me duplicate check kis field par (Email best hai)
RECRUIT_DUPLICATE_FIELD=Email

# ---- Screening ----
# WorkDrive folder holding the role folders (ROOT / role / date / resumes)
WORKDRIVE_ROOT_FOLDER_ID=your_workdrive_root_folder_id
# Starting pass score for a role (each role can change it in the UI)
DEFAULT_PASS_THRESHOLD=70
# Kill switch: false = passed candidates still go to Recruit, but no file is deleted
WORKDRIVE_DELETE_ENABLED=true
